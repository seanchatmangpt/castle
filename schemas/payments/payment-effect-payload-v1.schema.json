{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://castle.local/schemas/payments/payment-effect-payload-v1.schema.json",
  "title": "PaymentEffectPayloadV1",
  "description": "Payload of a payments.transfer.v1 PreparedEffect (src/payments/effect.rs Payload). Amount is a canonical base-10 minor-unit string.",
  "type": "object",
  "additionalProperties": false,
  "required": ["amount", "currency", "obligation_id", "purpose"],
  "properties": {
    "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
    "currency": { "type": "string", "enum": ["USD", "EUR", "GBP", "JPY", "KWD"] },
    "obligation_id": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "reverses": { "type": "string" }
  }
}
