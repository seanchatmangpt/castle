@prefix sj: <https://ggen-igniter.dev/ontology/semantic-jira#> .
@prefix a2a: <https://ggen-igniter.dev/ontology/a2a#> .
@prefix gi: <https://ggen-igniter.dev/ontology/ggen-igniter#> .
@prefix c10: <https://ggen-igniter.dev/sjira/castle-26.10.8#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# CASTLE v26.10.8 crown gates as observable A2A skills.
#
# Companion to docs/sjira/v26.10.8/goal.ttl. Annotates the fourteen v26.9.28
# crown gates (CASTLE-28-0 .. CASTLE-28-13) as sj:Action individuals following
# the semantic-jira-pack gates/060_a2a_skills.rq mechanism: every exposed
# skill is an sj:Action with a2a:skillName, a2a:ashAction, a2a:consequence,
# a2a:exposed true, a2a:requiresCapability naming the owning capability from
# docs/sjira/v26.9.28/repos.ttl, and a2a:generatedBy a generator carrying
# gi:standing "ALIVE" as gate 060 requires.
#
# OBSERVE surface only. These are gate STATUS queries. Every description
# carries the surface law verbatim: receipt-driven STOP; SELECT never implies DO. A SELECT result never actuates; the
# sole CONSTRUCT -> DO boundary remains BRCE (goal.ttl law, unchanged).

c10:gate-skill-generator
    a gi:Generator ;
    rdfs:label "castle goal graph projection generator" ;
    gi:standing "ALIVE" ;
    dcterms:description "The v26.10.8 goal graph projection that exposes crown-gate status queries as observable A2A skills." .

c10:skill-gate-0
    a sj:Action ;
    a2a:skillName "castle.gate.0" ;
    a2a:ashAction "gate_status" ;
    a2a:consequence "NONE" ;
    a2a:exposed true ;
    a2a:requiresCapability "CONSEQUENTIAL_ADMISSIBILITY" ;
    a2a:generatedBy c10:gate-skill-generator ;
    rdfs:label "Crown gate 0: Product crown: CASTLE owns board constitution and consequence admissibility" ;
    dcterms:description "Status query for CASTLE-28-0 (Product crown: CASTLE owns board constitution and consequence admissibility). OBSERVE surface: receipt-driven STOP; SELECT never implies DO." .

