{
  "schema": "castle.fabric.v1",
  "version": "26.9.30",
  "requiredUris": [
    "capability://projection/map",
    "capability://process/conformance",
    "capability://law/admit",
    "capability://evidence/attest",
    "capability://agent/actuate"
  ],
  "failureClasses": {
    "SEMANTIC_REFUSAL": {
      "fallsOver": false
    },
    "AUTHORITY_REFUSAL": {
      "fallsOver": false
    },
    "PROCESS_INVALID": {
      "fallsOver": false
    },
    "REALIZATION_FAILED": {
      "fallsOver": true
    },
    "EVIDENCE_INSUFFICIENT": {
      "fallsOver": false
    },
    "UNSUPPORTED": {
      "fallsOver": false
    },
    "CAPABILITY_UNAVAILABLE": {
      "fallsOver": false
    }
  },
  "typedRefusals": [
    "REFUSED:<code>",
    "BLOCKED:<code>"
  ],
  "doNeverFallsOver": true,
  "runtimeOwner": "seanchatmangpt/xaas (Xaas.Fabric)",
  "castleOwns": [
    "operation_envelope"
  ],
  "cliFailureContract": {
    "stdout": "{\"ok\":false,\"class\":\"refused|blocked|standing|error\",...}",
    "exit": {
      "2": "REFUSED/BLOCKED",
      "3": "non-settled standing",
      "1": "other"
    }
  }
}
